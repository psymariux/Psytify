# Copy to .env.build (it stays out of the repository).
# The backend address that distribution builds (Arch package, APK) use by default.
# Without it, the app starts on http://127.0.0.1:8080 (desktop) or http://10.0.2.2:8080 (Android emulator).
PSYTIFY_DEFAULT_API_URL=https://api.example.com
# The Clerk login of distribution builds: the instance Frontend API and the client ID of the public
# OAuth application (see docs/BACKEND.md). Without them, login stays off until config.json sets them.
PSYTIFY_DEFAULT_CLERK_ISSUER=https://your-instance.clerk.accounts.dev
PSYTIFY_DEFAULT_CLERK_CLIENT_ID=
