# Copy to .env.build (it stays out of the repository).
# The backend address that distribution builds (Arch package, APK) use by default.
# Without it, the app starts on http://127.0.0.1:8080 (desktop) or http://10.0.2.2:8080 (Android emulator).
PSYTIFY_DEFAULT_API_URL=https://api.example.com
# The Clerk sign-in of distribution builds: the instance Frontend API (see the README).
# Without it, sign-in stays off until config.json sets it. The client no longer needs an OAuth client ID.
PSYTIFY_DEFAULT_CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Application ID of the "Psytify" Discord app for Rich Presence (a number, public).
# Without it, nothing is shown on Discord until config.json sets discord_app_id.
PSYTIFY_DEFAULT_DISCORD_APP_ID=
