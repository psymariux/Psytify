# Copy to .env.build (stays out of the repository).
# The backend address that the distribution builds (Arch package, APK) use by default.
# Without it: the app starts at http://127.0.0.1:8080 (desktop) or http://10.0.2.2:8080 (Android emulator).
PSYTIFY_DEFAULT_API_URL=https://api.example.com
# The Clerk login of the distribution builds: the instance's Frontend API (docs/OPERATIONS.md).
# Without it: login off until config.json sets it. The client ID OAuth is no longer used by the client.
PSYTIFY_DEFAULT_CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Application ID of the Discord app «Psytify» for Rich Presence (a public number).
# Without it: no status on Discord until config.json sets discord_app_id.
PSYTIFY_DEFAULT_DISCORD_APP_ID=
